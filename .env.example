PORT=3000
MONGO_URI=mongodb+srv://USERNAME:PASSWORD@HOST/rivayat
APP_SECRET=replace-with-at-least-32-random-characters
ALLOWED_ORIGINS=http://localhost:3000,https://rivayat.shop,https://www.rivayat.shop

# Optional: seed an administrator only when both values are present.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_USERNAME=
ADMIN_NAME=Rivayat Owner
ADMIN_PHONE=

# Customer email / OTP / order updates
RESEND_API_KEY=
EMAIL_FROM=RIVAYAT <orders@your-domain.example>

# Google sign-in
GOOGLE_CLIENT_ID=
GOOGLE_MAPS_API_KEY=

# Razorpay payment gateway (keep the secret server-side only)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Optional operations alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
