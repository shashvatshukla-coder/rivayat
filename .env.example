PORT=3000
# Use the MongoDB Atlas driver connection string. MONGODB_URI is accepted as
# an alias, but an Atlas API key is not a database connection string.
MONGO_URI=mongodb+srv://USERNAME:PASSWORD@HOST/rivayat
APP_SECRET=replace-with-at-least-32-random-characters
ALLOWED_ORIGINS=http://localhost:3000,https://rivayat.onrender.com,https://rivayat.shop,https://www.rivayat.shop

# Optional: seed an administrator only when both values are present.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_USERNAME=
ADMIN_NAME=Rivayat Owner
ADMIN_PHONE=

# Customer email / OTP / order updates
# Required in production for account creation and password-reset delivery.
RESEND_API_KEY=
EMAIL_FROM=RIVAYAT <orders@your-domain.example>

# Customer return/exchange window after delivery (1-30 days)
RETURN_WINDOW_DAYS=7

# Google sign-in
GOOGLE_CLIENT_ID=
GOOGLE_MAPS_API_KEY=

# Optional hosted search. Keep the admin key on Render only. The search key may
# be a restricted search-only key; neither key belongs in index.html.
ALGOLIA_APP_ID=
ALGOLIA_SEARCH_API_KEY=
ALGOLIA_ADMIN_API_KEY=
ALGOLIA_INDEX_NAME=rivayat_products

# Reserved for a future server-verified Razorpay integration. Online payment
# stays disabled in the storefront until create-order and signature verification
# are implemented server-side. Never put this secret in index.html.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Optional operations alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
