# Core — required on Render
NODE_ENV=production
MONGO_URI=mongodb+srv://USER:PASSWORD@HOST/rivayat
APP_SECRET=replace-with-at-least-32-random-characters
BASE_URL=https://www.rivayat.shop
ALLOWED_ORIGINS=https://rivayat.shop,https://www.rivayat.shop,https://YOUR-SERVICE.onrender.com

# Safe catalog replacement — leave `replace` for the first deployment of this version.
# The server backs up all existing MongoDB product documents before replacement.
CATALOG_SYNC_MODE=replace
CATALOG_VERSION=2026-08-24-supplied-assets-v1

# First administrator seed — use a unique email and a 12+ character password.
# Remove ADMIN_PASSWORD from Render after the administrator account has been created.
ADMIN_NAME=Rivayat Owner
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=replace-with-a-strong-unique-password
ADMIN_USERNAME=rivayat-admin
ADMIN_PHONE=9000000000

# Transactional email — required for signup and forgot-password OTP delivery
RESEND_API_KEY=re_xxxxxxxxx
EMAIL_FROM=RIVAYAT <orders@rivayat.shop>

# Google account login — optional
GOOGLE_CLIENT_ID=000000000000-example.apps.googleusercontent.com

# Optional Style Lab provider — the clothing-photo recommender stays disabled when unset
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

# Server-only owner arcade gate (keep private; never paste this into client code)
SWASTIK_SECRET=choose-a-private-owner-code

# Algolia search — optional; never expose the admin key in browser code
ALGOLIA_APP_ID=YOUR_APP_ID
ALGOLIA_SEARCH_API_KEY=YOUR_SEARCH_ONLY_KEY
ALGOLIA_ADMIN_API_KEY=YOUR_SERVER_ONLY_ADMIN_KEY
ALGOLIA_INDEX_NAME=rivayat_products
ALGOLIA_AUTO_REINDEX=true

# Google Merchant Center product feed — public account ID, not a secret
MERCHANT_CENTER_ID=10717371386

# Search Console — paste only the verification token, not the full meta tag
GOOGLE_SITE_VERIFICATION=your-google-verification-token

# Business and invoice details
BUSINESS_LEGAL_NAME=RIVAYAT Fashion
BUSINESS_ADDRESS=Your complete legal or return address, India
BUSINESS_GSTIN=
SUPPORT_EMAIL=houseofrivayat@gmail.com
SUPPORT_PHONE=+91 80041 09305

# Loyalty and returns
LOYALTY_EARN_PERCENT=2
LOYALTY_MAX_REDEMPTION_PERCENT=20
RETURN_WINDOW_DAYS=7

# Order and operational notifications — optional
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
